{
  "tasks": {
    "build": "deno run --allow-env --allow-read --allow-write --allow-run scripts/esbuild.ts",
    "zip": "deno task build --minify; zip -vr dist.zip dist -x \"*.DS_Store\"",
    "format": "deno fmt",
    "lint": "deno lint",
    "check": "deno check .",
    "up:latest": "deno outdated --update --latest"
  },
  "imports": {
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/fs": "jsr:@std/fs@^1.0.14",
    "@types/chrome": "npm:@types/chrome@^0.0.309",
    "esbuild": "npm:esbuild@^0.25.1",
    "asearch": "https://raw.githubusercontent.com/takker99/deno-asearch/0.2.1/mod.ts",
    "scrapbox-parser": "https://esm.sh/@progfay/scrapbox-parser@7.2.0",
    "scrapbox-type": "https://raw.githubusercontent.com/scrapbox-jp/types/0.0.8/mod.ts",
    "re_expand": "https://esm.sh/re_expand@0.2.0"
  },
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true
  }
}
