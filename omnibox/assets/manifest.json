{
  "name": "HelpLine(v3)",
  "description": "HelpLine",
  "version": "0.0.3",
  "manifest_version": 3,
  "action": {
    "default_title": "Click to show an alert"
  },
  "content_scripts": [
    {
      "js": [
        "content_script.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "/"
  },
  "icons": {
    "16": "icons/helpline-16.png",
    "32": "icons/helpline-32.png",
    "48": "icons/helpline-48.png",
    "128": "icons/helpline-128.png"
  },
  "options_ui": {
    "page": "setting.html",
    "open_in_tab": false
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ]
}